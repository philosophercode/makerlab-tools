{
  "name": "makerlab-tools-v5",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "eval": "vitest run --config evals/vitest.config.ts",
    "qr:labels": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/generate-qr-labels.ts",
    "migrate:resources": "node --env-file=.env.local --experimental-strip-types scripts/migrate-tools-to-resources.ts",
    "drop:deprecated-columns": "node --env-file=.env.local --experimental-strip-types scripts/drop-deprecated-notion-columns.ts",
    "clear:migration-notes": "node --env-file=.env.local --experimental-strip-types scripts/clear-resource-migration-notes.ts",
    "spec:coverage": "node --experimental-strip-types scripts/check-spec-coverage.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/db-migrate.ts",
    "import:notion": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/import-notion.ts",
    "verify:import": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-import.ts",
    "manuals:index": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/index-manuals.ts",
    "names:backfill": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/backfill-display-names.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.160",
    "@ai-sdk/react": "^3.0.97",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "ai": "^6.0.95",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "match-sorter": "^8.3.0",
    "next": "16.1.6",
    "next-intl": "^4.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "unpdf": "^1.8.1",
    "workflow": "^4.8.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@workflow/vitest": "^4.0.25",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
