{
  "name": "makerlab-tools",
  "version": "5.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/philosophercode/makerlab-tools.git"
  },
  "homepage": "https://www.makerlabai.app",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "eval": "vitest run --config evals/vitest.config.ts",
    "eval:all": "bash scripts/eval-all.sh",
    "eval:manual-questions": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config evals/manual-questions.vitest.config.ts",
    "starters:refresh": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/starters-refresh.ts",
    "qr:labels": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/generate-qr-labels.ts",
    "spec:coverage": "node --experimental-strip-types scripts/check-spec-coverage.ts",
    "lab:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/lab-check.ts",
    "lab:schema": "node --experimental-strip-types scripts/lab-schema.ts",
    "lab:map-preview": "node --experimental-strip-types scripts/lab-map-preview.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/db-migrate.ts",
    "import:notion": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/import-notion.ts",
    "verify:import": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-import.ts",
    "manuals:index": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/index-manuals.ts",
    "manuals:eval-questions": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/manual-eval-questions.ts",
    "tools:skills": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/tool-skills.ts",
    "names:backfill": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/backfill-display-names.ts",
    "descriptions:shorten": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/shorten-descriptions.ts",
    "resources:language": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/resource-language.ts",
    "projects:seed": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed-projects.ts",
    "thumbnails:bundled": "node --experimental-strip-types scripts/generate-tool-thumbnails.ts",
    "thumbnails:backfill": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/backfill-thumbnails.ts",
    "images:recut": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/recut-tool-cover.ts",
    "taxonomy:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/taxonomy-migrate.ts",
    "taxonomy:audit": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/taxonomy-audit.ts",
    "inventory:cleanup": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/inventory-cleanup.ts",
    "data:push": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/push-local-to-hosted.ts",
    "blob:repoint": "node --experimental-strip-types scripts/repoint-hosted-blobs.ts",
    "manuals:resolve-links": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/resolve-manual-links.ts",
    "resources:clean-urls": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/clean-resource-urls.ts",
    "smoke:production": "bash scripts/smoke-production.sh"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.221",
    "@ai-sdk/react": "^3.0.318",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.8.2",
    "ai": "^6.0.315",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "heic-decode": "^2.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.48.0",
    "match-sorter": "^8.3.0",
    "next": "16.4.3",
    "next-intl": "^4.13.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.1",
    "unpdf": "^1.8.1",
    "use-stick-to-bottom": "^1.1.6",
    "workflow": "^4.8.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@workflow/vitest": "^4.0.30",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "zod": "^4.6.7",
    "devalue": "^5.9.3",
    "@workflow/world-vercel": {
      "undici": "^7.30.1"
    },
    "@workflow/world-local": {
      "undici": "^7.30.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
